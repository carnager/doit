class AuthError(Exception):
    pass


def load_config():
    cfg = {}
    try:
        import tomllib
        with open(CONFIG, "rb") as fh:
            cfg = tomllib.load(fh)
    except (OSError, ValueError, ImportError):
        pass
    if os.environ.get("JOT_SERVER"):
        cfg["server"] = os.environ["JOT_SERVER"]
    if cfg.get("server"):
        cfg["server"] = cfg["server"].rstrip("/")
    return cfg


def private_write(path, data):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(data)
    os.replace(tmp, path)


class Jot:
    """Items mirrored from the server, kept in a private cache file."""

    def __init__(self, server):
        self.server = server
        key = hashlib.sha1(server.encode()).hexdigest()[:10]
        self.state_path = os.path.join(CACHE, f"state-{key}.json")
        self.token_path = os.path.join(CACHE, f"token-{key}")
        self.lock = threading.RLock()
        self.items, self.rev, self.dirty = {}, 0, {}
        self.settings = {}
        try:
            with open(self.state_path) as fh:
                st = json.load(fh)
            self.items, self.rev = st.get("items", {}), st.get("rev", 0)
            self.dirty, self.settings = st.get("dirty", {}), st.get("settings", {})
        except (OSError, ValueError):
            pass
        try:
            with open(self.token_path) as fh:
                self.token = fh.read().strip() or None
        except OSError:
            self.token = None

    def save(self):
        with self.lock:
            data = json.dumps({"rev": self.rev, "items": self.items, "dirty": self.dirty, "settings": self.settings})
        private_write(self.state_path, data)

    def request(self, method, path, body=None, timeout=10, auth=True):
        req = urllib.request.Request(self.server + path, method=method,
                                     data=None if body is None else json.dumps(body).encode(),
                                     headers={"Content-Type": "application/json", "User-Agent": "doit-jot"})
        if auth:
            if not self.token:
                raise AuthError()
            req.add_header("Authorization", "Bearer " + self.token)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return json.loads(r.read() or b"null")
        except urllib.error.HTTPError as e:
            if e.code == 401:
                raise AuthError() from e
            try:
                msg = json.loads(e.read()).get("error")
            except (ValueError, AttributeError):
                msg = None
            raise OSError(msg or f"HTTP {e.code}") from e

    def login(self, username, password):
        r = self.request("POST", "/api/login", {"username": username, "password": password,
                                                "device": "doit on " + os.uname().nodename}, auth=False)
        self.token = r["token"]
        private_write(self.token_path, self.token)

    def logout(self):
        try:
            self.request("POST", "/api/logout", {}, timeout=3)
        except (OSError, AuthError):
            pass
        self.token = None
        for p in (self.token_path, self.state_path):
            try:
                os.unlink(p)
            except OSError:
                pass
        with self.lock:
            self.items, self.rev, self.dirty = {}, 0, {}

    def sync(self):
        """Push what changed here, take what changed there. True if anything did."""
        with self.lock:
            changes = list(self.dirty.values())
            since = self.rev
        r = self.request("POST", "/api/sync", {"since": since, "changes": changes})
        with self.lock:
            for it in r.get("items") or []:
                mine = self.dirty.get(it["id"])
                if mine is not None and mine not in changes:
                    continue  # changed again while this was underway: pushed next time
                self.dirty.pop(it["id"], None)
                if it.get("deleted"):
                    self.items.pop(it["id"], None)
                else:
                    self.items[it["id"]] = it
            for c in changes:
                if self.dirty.get(c["id"]) is c:
                    self.dirty.pop(c["id"], None)
            changed = bool(r.get("items")) or r.get("rev", since) != since
            self.rev = max(self.rev, r.get("rev") or 0)
        if not self.settings:
            try:
                self.settings = self.request("GET", "/api/settings") or {}
            except (OSError, AuthError):
                pass
        self.save()
        return changed

    def put(self, it):
        """A local change: kept, then pushed (or kept dirty when offline)."""
        with self.lock:
            self.items[it["id"]] = it
            self.dirty[it["id"]] = it
        self.save()
        try:
            self.sync()
            return None
        except AuthError:
            return "Sign in again to sync this"
        except OSError as e:
            return f"Saved here; Jot is unreachable ({e})"

    def change(self, iid, **fields):
        with self.lock:
            prev = self.items.get(iid)
            if prev is None:
                return None, "That item is gone"
            nxt = stamped(prev, dict(prev, **fields), now_ms())
        return nxt, self.put(nxt)

    def events(self, on_rev):
        """Follow /api/events; call on_rev when the server has newer data."""
        while self.token:
            try:
                req = urllib.request.Request(self.server + "/api/events",
                                             headers={"Authorization": "Bearer " + self.token,
                                                      "Accept": "text/event-stream", "User-Agent": "doit-jot"})
                with urllib.request.urlopen(req, timeout=60) as r:
                    for raw in r:
                        line = raw.decode(errors="replace").strip()
                        if line.startswith("data:"):
                            try:
                                if int(line[5:].strip()) > self.rev:
                                    on_rev()
                            except ValueError:
                                pass
            except AuthError:
                return
            except (OSError, ValueError):
                time.sleep(5)

    def thumbnail(self, img_id):
        path = os.path.join(CACHE, "thumbs", img_id + ".jpg")
        if os.path.exists(path):
            return path
        try:
            req = urllib.request.Request(f"{self.server}/api/attachments/{img_id}?w=240",
                                         headers={"Authorization": "Bearer " + (self.token or ""),
                                                  "User-Agent": "doit-jot"})
            with urllib.request.urlopen(req, timeout=10) as r:
                data = r.read()
            os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
            tmp = path + ".tmp"
            with open(tmp, "wb") as fh:
                fh.write(data)
            os.chmod(tmp, 0o600)
            os.replace(tmp, path)
            return path
        except (OSError, urllib.error.URLError):
            return None


