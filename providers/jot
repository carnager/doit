LIST_SEP = "› "      # a checklist's view:  "list:ID › "
WHEN_SEP = "› "      # rescheduling:          "when:ID › "
SNOOZE_MIN = 60


class Mode:
    def __init__(self, cfg):
        self.cfg = cfg
        self.jot = Jot(cfg["server"])
        self.out_lock = threading.Lock()
        self.query = ""
        self.handlers = {}
        self.scope = None
        self.undo = None          # (label, item before)
        self.notice = self.shown_notice = None
        self.thumbs_wanted = set()
        self.refresh_lock = threading.Lock()

    def emit(self, *objs):
        with self.out_lock:
            for o in objs:
                sys.stdout.write(json.dumps(o, ensure_ascii=False) + "\n")
            sys.stdout.flush()

    # ── rows ──────────────────────────────────────────────────────────────────
    def item(self, iid, fn, **row):
        self.handlers[iid] = fn
        return dict(row, id=iid)

    def when_bits(self, it, today):
        bits = []
        if it.get("due"):
            p = parse_due(it["due"])
            snooze = parse_due(it.get("snoozedUntil"))
            s = human_due(it["due"], today)
            if snooze:
                s += f" · snoozed to {human_due(it['snoozedUntil'], today)}"
            if p and p[0] < today and not it.get("done"):
                s = "overdue · " + s
            bits.append(s)
        if it.get("repeat"):
            bits.append(human_repeat(it["repeat"]))
        return bits

    def icon_for(self, it):
        imgs = it.get("images") or []
        if imgs:
            path = os.path.join(CACHE, "thumbs", imgs[0]["id"] + ".jpg")
            if os.path.exists(path):
                return path
            self.thumbs_wanted.add(imgs[0]["id"])
        color = it.get("color") or ""
        if it.get("done"):
            return icon("done", color or "green")
        if it.get("due"):
            return icon("repeat" if it.get("repeat") else "task", color)
        return icon("list" if it.get("kind") == "list" else "note", color)

    def row(self, it, today, badge=None):
        is_task = bool(it.get("due")) and not it.get("done")
        bits = self.when_bits(it, today)
        checks = live_checks(it)
        if it.get("kind") == "list" and checks:
            done = sum(1 for c in checks if c.get("done"))
            bits.append(f"{done}/{len(checks)} done")
        elif it.get("body"):
            bits.append(" ".join(it["body"].split())[:90])
        bits += ["#" + lb for lb in it.get("labels") or []]
        if it.get("archived"):
            badge = "archived"
        elif it.get("done"):
            badge = badge or "done"
        elif it.get("pinned") and not badge:
            badge = "pinned"
        title = it.get("title") or (it.get("body") or "").split("\n")[0][:80] or "Untitled"
        acts = []
        if is_task:
            if due_key(it) <= today * 1440 + now_parts()[1]:  # its time has come: a reminder to put off
                acts.append({"title": "Snooze 1 hour", "id": "snooze", "icon": "alarm-symbolic", "keep_open": True})
            acts += [
                {"title": "Tomorrow", "id": "tomorrow", "icon": "go-next", "keep_open": True},
                {"title": "Next week", "id": "nextweek", "icon": "go-last", "keep_open": True},
            ]
        if not it.get("archived"):
            acts.append({"title": "Change the date…" if it.get("due") else "Add a date…", "id": "when",
                         "icon": "appointment-new", "keep_open": True})
        if it.get("done"):
            acts.insert(0, {"title": "Not done", "id": "undone", "icon": "edit-undo", "keep_open": True})
        elif is_task and it.get("kind") == "list":
            acts.insert(0, {"title": "Complete", "id": "complete", "icon": "object-select", "keep_open": True})
        if it.get("due") and not it.get("done"):
            acts.append({"title": "Remove the date", "id": "nodate", "icon": "edit-clear", "keep_open": True})
        acts += [
            {"title": "Unpin" if it.get("pinned") else "Pin", "id": "pin", "icon": "pin", "keep_open": True},
            {"title": "Unarchive" if it.get("archived") else "Archive", "id": "archive", "icon": "archive",
             "keep_open": True},
            {"title": "Move to the trash", "id": "trash", "icon": "user-trash", "keep_open": True},
            {"title": "Copy the text", "id": "copy", "icon": "edit-copy"},
            {"title": "Open in Jot", "id": "web", "icon": "internet-web-browser"},
        ]
        if it.get("kind") == "list":
            verb = "Open"
        elif is_task:
            verb = "Next date" if it.get("repeat") else "Done"
        elif it.get("done"):
            verb = "Not done"
        else:
            verb = "Open in Jot"
        return self.item(it["id"], lambda a, iid=it["id"]: self.on_item(iid, a), title=title,
                         subtitle=" · ".join(b for b in bits if b), icon=self.icon_for(it), badge=badge,
                         verb=verb, actions=acts, keep_open=is_task or it.get("kind") == "list")

    # ── views ─────────────────────────────────────────────────────────────────
    def view(self, q):
        self.handlers = {}
        if not self.jot.token:
            return self.signin_rows()
        today, minute = now_parts()
        if q.startswith("list:"):
            return self.list_view(q, today)
        if q.startswith("when:"):
            return self.when_view(q, today, minute)
        self.set_scope(None)
        rows = []
        if self.undo and not q.strip():
            label, _ = self.undo
            rows.append(self.item("undo", lambda _a: self.do_undo(), title=f"Undo: {label}", icon="edit-undo",
                                  sticky=True, keep_open=True, verb="Undo"))
        if not q.strip():
            return rows + self.home(today)
        return rows + self.search(q, today, minute)

    def home(self, today):
        with self.jot.lock:
            items = [it for it in self.jot.items.values() if alive(it) and not it.get("archived")]
        open_tasks = sorted((it for it in items if it.get("due") and not it.get("done")), key=due_key)
        overdue = [it for it in open_tasks if parse_due(it["due"])[0] < today]
        due_today = [it for it in open_tasks if parse_due(it["due"])[0] == today]
        soon = [it for it in open_tasks if today < parse_due(it["due"])[0] <= today + 7]
        notes = sorted((it for it in items if not it.get("due") and not it.get("done")),
                       key=lambda it: (not it.get("pinned"), -(it.get("sort") or 0)))
        rows = [self.row(it, today, "overdue") for it in overdue]
        rows += [self.row(it, today, "today") for it in due_today]
        rows += [self.row(it, today, rel_day(parse_due(it["due"])[0], today).split()[0].lower()) for it in soon]
        rows += [self.row(it, today) for it in notes]
        if not rows:
            rows = [{"title": "Nothing here yet", "subtitle": "Type to jot something down", "icon": icon("add", "accent"),
                     "sticky": True}]
        return rows

    def search(self, q, today, minute):
        rows = []
        words = q.split()
        last = words[-1] if words and not q.endswith(" ") else ""
        # "#wo" → the labels that start so, to complete
        if last.startswith("#"):
            with self.jot.lock:
                labels = sorted({lb for it in self.jot.items.values() if alive(it) for lb in it.get("labels") or []})
            stem = norm(last[1:])
            for lb in labels:
                if norm(lb).startswith(stem) and lb != last[1:]:
                    rows.append({"id": "label:" + lb, "title": "#" + lb, "subtitle": "label",
                                 "icon": icon("label", "accent"), "set_query": q[:len(q) - len(last)] + "#" + lb + " ",
                                 "verb": "Complete", "badge": "label"})
        p = quickadd(q.strip(), today, minute)
        only_labels = all(w.startswith("#") for w in words)
        if p["title"] and not only_labels:
            rows.insert(0, self.capture_row(q.strip(), p, today))
        # Found by what's left of the words once dates and times are read
        # out of them ("dentist tomorrow" finds the dentist); a date alone
        # ("tomorrow", "fri") finds what's due then.
        terms = norm(p["title"]).split() + ["#" + lb for lb in p["labels"]]
        if last.startswith("#"):
            terms = [t for t in terms if t != norm(last)] + [norm(last)]
        on_day = parse_due(p["due"])[0] if p["due"] and not p["title"] and not p["repeat"] else None
        if on_day is not None:
            rows.insert(0, {"title": f"Due {rel_day(on_day, today).lower() if on_day - today in (0, 1) else rel_day(on_day, today)}",
                            "subtitle": "what's on that day", "icon": "x-office-calendar", "sticky": True,
                            "id": "dayhead"})
        with self.jot.lock:
            if on_day is not None:
                found = [it for it in self.jot.items.values() if alive(it) and not it.get("archived")
                         and parse_due(it.get("due")) and parse_due(it["due"])[0] == on_day
                         and all(t in haystack(it) for t in terms)]
            elif terms:
                found = [it for it in self.jot.items.values() if alive(it) and all(t in haystack(it) for t in terms)]
            else:
                found = []
        found.sort(key=lambda it: (bool(it.get("archived")), bool(it.get("done")), not it.get("pinned"),
                                   due_key(it) if it.get("due") and not it.get("done") else float("inf"),
                                   -(it.get("sort") or 0)))
        found_rows = [self.row(it, today) for it in found[:60]]
        if rows and rows[0].get("id") == "capture" and not p["tokens"] and found and \
                norm(found[0].get("title")) == norm(p["title"]):
            # exactly an item's title, nothing else: that item, not a duplicate
            rows = rows[1:] + found_rows[:1] + rows[:1] + found_rows[1:]
        else:
            rows += found_rows
        if not rows:
            rows = [{"title": "Nothing found", "subtitle": f"for “{q.strip()}”", "icon": "edit-find", "sticky": True}]
        return rows

    def capture_row(self, text, p, today):
        bits = []
        if p["due"]:
            bits.append(human_due(p["due"], today))
        if p["repeat"]:
            bits.append(human_repeat(p["repeat"]))
        if p["kind"] == "list":
            bits.append(f"checklist: {', '.join(c['text'] for c in p['checks'])}")
        bits += ["#" + lb for lb in p["labels"]]
        if p["pinned"]:
            bits.append("pinned")
        kind = "task" if p["due"] else "note"
        acts = []
        if p["tokens"]:
            acts.append({"title": "Add it word for word", "id": "literal", "icon": "format-text-plain"})
        acts.append({"title": "Add and keep going", "id": "more", "icon": "list-add", "keep_open": True})
        return self.item("capture", lambda a: self.capture(text, a), title=p["title"],
                         subtitle=" · ".join(bits) or ("a todo" if kind == "task" else "a note"),
                         icon=icon("add", "accent"), badge="new " + ("todo" if p["due"] else "note"), verb="Add",
                         sticky=True, actions=acts)

    def list_view(self, q, today):
        iid, _, rest = q[5:].partition(" " + LIST_SEP)
        it = self.jot.items.get(iid)
        if not it or not alive(it):
            self.set_scope(None)
            return [{"title": "That list is gone", "icon": "dialog-error", "sticky": True, "set_query": ""}]
        self.set_scope(f"list:{iid} {LIST_SEP}", it.get("title") or "Checklist")
        text = rest.strip()
        rows = []
        if text:
            rows.append(self.item("addcheck", lambda _a: self.add_check(iid, text), title=text,
                                  subtitle=f"add to {it.get('title') or 'the list'}", icon=icon("add", "accent"),
                                  verb="Add", sticky=True, keep_open=True))
        checks = live_checks(it)
        terms = norm(text).split()
        shown = [c for c in checks if all(t in norm(c.get("text")) for t in terms)]
        shown.sort(key=lambda c: bool(c.get("done")))  # open ones first, in their order
        for c in shown:
            rows.append(self.item(
                f"check:{c['id']}", lambda a, cid=c["id"]: self.on_check(iid, cid, a), title=c.get("text") or "",
                icon=icon("checked" if c.get("done") else "check", it.get("color") or ""),
                subtitle=None, badge="done" if c.get("done") else None, verb="Untick" if c.get("done") else "Tick",
                keep_open=True,
                actions=[{"title": "Delete", "id": "delete", "icon": "edit-delete", "keep_open": True}]))
        if not text:
            done = sum(1 for c in checks if c.get("done"))
            if done:
                rows.append(self.item("uncheckall", lambda _a: self.set_checks(iid, False), title="Untick everything",
                                      subtitle=f"{done} ticked", icon="edit-undo", keep_open=True, verb="Untick"))
            if it.get("due") and not it.get("done"):
                rows.append(self.item("completelist", lambda _a: (self.on_item(iid, "complete"), self.go(""))[1],
                                      title="Complete the list", subtitle=" · ".join(self.when_bits(it, today)),
                                      icon=icon("done", it.get("color") or "green"), keep_open=True, verb="Done"))
            rows.append(self.item("weblist", lambda _a: self.open_web(iid), title="Open in Jot",
                                  icon="internet-web-browser", verb="Open"))
        if not shown and not text:
            rows.insert(0, {"title": "No checks yet", "subtitle": "Type one to add it", "icon": "edit-find",
                            "sticky": True})
        return rows

    def when_view(self, q, today, minute):
        iid, _, rest = q[5:].partition(" " + WHEN_SEP)
        it = self.jot.items.get(iid)
        if not it:
            self.set_scope(None)
            return [{"title": "That item is gone", "icon": "dialog-error", "sticky": True, "set_query": ""}]
        self.set_scope(f"when:{iid} {WHEN_SEP}", "When: " + (it.get("title") or "Untitled"))
        text = rest.strip()
        if not text:
            cur = human_due(it.get("due"), today) if it.get("due") else "no date"
            examples = ["tomorrow 9am", "fri 18:00", "in 3 days", "next week", "every mon 8:00", "29.12."]
            return [{"title": "Type when", "subtitle": f"now {cur} · e.g. " + ", ".join(examples),
                     "icon": "appointment-new", "sticky": True}]
        due, repeat, ok = parse_when(text, today, minute)
        if not ok or not due:
            return [{"title": "Not a date I know", "subtitle": "e.g. tomorrow 9am, fri 18:00, in 3 days, every mon",
                     "icon": "dialog-question", "sticky": True}]
        bits = [human_due(due, today)] + ([human_repeat(repeat)] if repeat else [])
        return [self.item("setwhen", lambda _a: (self.set_when(iid, due, repeat), self.go(""))[1],
                          title=" · ".join(bits), subtitle=it.get("title") or "", icon="appointment-new", verb="Set",
                          sticky=True, keep_open=True)]

    def signin_rows(self):
        return [self.item("signin", lambda _a: self.spawn_login(), title="Sign in to Jot",
                          subtitle=self.cfg["server"], icon="dialog-password", verb="Sign in", sticky=True)]

    def set_scope(self, match, label=None):
        sc = {"match": match, "label": label} if match else None
        if sc != self.scope:
            self.scope = sc
            self.emit({"scope": sc})

    # ── actions ───────────────────────────────────────────────────────────────
    def remember(self, label, iid):
        prev = self.jot.items.get(iid)
        if prev:
            self.undo = (label, json.loads(json.dumps(prev)))

    def do_undo(self):
        if not self.undo:
            return
        label, before = self.undo
        self.undo = None
        cur = self.jot.items.get(before["id"]) or before
        restore = {k: before.get(k) for k in [f for fs in GROUPS.values() for f in fs] + ["checks"] if k in before}
        nxt = stamped(cur, dict(cur, **restore), now_ms())
        self.notice = self.jot.put(nxt)

    def on_item(self, iid, act):
        it = self.jot.items.get(iid)
        if not it:
            return
        title = it.get("title") or "Untitled"
        today, minute = now_parts()
        is_task = bool(it.get("due")) and not it.get("done")
        if act is None:
            if it.get("kind") == "list":
                return self.open_list(iid)
            if is_task:
                act = "complete"
            elif it.get("done"):
                act = "undone"
            else:
                return self.open_web(iid)
        err = None
        if act == "complete":
            self.remember(f"completed {title}", iid)
            nxt, err = self.jot.change(iid, **complete_fields(it, today, minute, now_ms()))
            if nxt and not nxt.get("done"):
                self.notice = f"{title} — next: {human_due(nxt['due'], today)}"
        elif act == "undone":
            self.remember(f"reopened {title}", iid)
            _, err = self.jot.change(iid, done=False, doneAt=0)
        elif act == "snooze":
            t = datetime.now() + timedelta(minutes=SNOOZE_MIN)
            t -= timedelta(minutes=t.minute % 5)
            until = t.strftime("%Y-%m-%dT%H:%M")
            self.remember(f"snoozed {title}", iid)
            _, err = self.jot.change(iid, snoozedUntil=until)
            self.notice = f"{title}: reminds you again at {until[11:]}"
        elif act in ("tomorrow", "nextweek"):
            p = parse_due(it["due"])
            day = today + 1 if act == "tomorrow" else next_weekday(today, 0)
            self.remember(f"moved {title}", iid)
            _, err = self.jot.change(iid, due=fmt_due(day, p[1] if p else None), snoozedUntil="")
        elif act == "nodate":
            self.remember(f"removed the date of {title}", iid)
            _, err = self.jot.change(iid, due="", snoozedUntil="", repeat=None)
        elif act == "when":
            return self.go(f"when:{iid} {WHEN_SEP}", "When: " + title)
        elif act == "pin":
            _, err = self.jot.change(iid, pinned=not it.get("pinned"))
        elif act == "archive":
            self.remember(f"{'unarchived' if it.get('archived') else 'archived'} {title}", iid)
            _, err = self.jot.change(iid, archived=not it.get("archived"), pinned=False)
        elif act == "trash":
            self.remember(f"trashed {title}", iid)
            _, err = self.jot.change(iid, trashedAt=now_ms())
        elif act == "copy":
            text = "\n".join([title] + ([it["body"]] if it.get("body") else [])
                             + [("[x] " if c.get("done") else "[ ] ") + (c.get("text") or "") for c in live_checks(it)])
            copy(text)
        elif act == "web":
            self.open_web(iid)
        self.notice = err or self.notice

    def open_list(self, iid):
        it = self.jot.items.get(iid) or {}
        return self.go(f"list:{iid} {LIST_SEP}", it.get("title") or "Checklist")

    def go(self, q, label=None):
        """Navigate: the pill first, so the new view never flashes its raw query."""
        if label:
            self.set_scope(q, label)
        else:
            self.set_scope(None)
        self.emit({"set_query": q})
        return "nav"

    def open_web(self, iid):
        subprocess.Popen(["xdg-open", f"{self.cfg['server']}/#/item/{iid}"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    def on_check(self, iid, cid, act):
        it = self.jot.items.get(iid)
        if not it:
            return
        checks = []
        for c in it.get("checks") or []:
            if c.get("id") == cid:
                c = {"id": cid, "deleted": True} if act == "delete" else dict(c, done=not c.get("done"))
            checks.append(c)
        _, self.notice = self.jot.change(iid, checks=checks)

    def set_checks(self, iid, done):
        it = self.jot.items.get(iid)
        if it:
            self.remember("unticked everything", iid)
            checks = [c if c.get("deleted") else dict(c, done=done) for c in it.get("checks") or []]
            _, self.notice = self.jot.change(iid, checks=checks)

    def add_check(self, iid, text):
        it = self.jot.items.get(iid)
        self.go(f"list:{iid} {LIST_SEP}", it.get("title") or "Checklist") if it else None
        if it:
            checks = list(it.get("checks") or [])
            # new ones go after the open ones, before the ticked
            pos = max((i + 1 for i, c in enumerate(checks) if not c.get("deleted") and not c.get("done")), default=0)
            checks.insert(pos, {"id": short_id(), "text": text, "done": False, "indent": 0})
            _, self.notice = self.jot.change(iid, checks=checks, kind="list")
        return "nav"

    def set_when(self, iid, due, repeat):
        it = self.jot.items.get(iid)
        if it:
            self.remember(f"rescheduled {it.get('title') or 'Untitled'}", iid)
            fields = {"due": due, "snoozedUntil": "", "done": False}
            if repeat is not None:
                fields["repeat"] = repeat
            _, self.notice = self.jot.change(iid, **fields)

    def capture(self, text, act):
        today, minute = now_parts()
        if act == "literal":
            it = new_item({"title": text})
        else:
            p = quickadd(text, today, minute)
            fields = {k: p[k] for k in ("title", "kind", "labels", "due", "repeat", "pinned")}
            fields["checks"] = p["checks"]
            it = new_item(fields)
        err = self.jot.put(it)
        if act == "more":
            self.notice = err or f"Added {it['title']}"
            return self.go("")
        if err:  # doit has closed; say it where it can be seen
            notify(it["title"], err)

    def spawn_login(self):
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "--login"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    # ── loop ──────────────────────────────────────────────────────────────────
    def show(self, q):
        rows = self.view(q)
        if self.notice != self.shown_notice:
            self.shown_notice = self.notice
            self.emit({"message": self.notice})
        self.emit({"items": rows})
        if self.thumbs_wanted:
            wanted, self.thumbs_wanted = list(self.thumbs_wanted), set()
            threading.Thread(target=self.fetch_thumbs, args=(wanted,), daemon=True).start()

    def fetch_thumbs(self, ids):
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(6) as pool:
            got = list(pool.map(self.jot.thumbnail, ids))
        if any(got):
            self.refresh()

    def refresh(self):
        with self.refresh_lock:
            self.show(self.query)

    def background_sync(self):
        try:
            if self.jot.sync():
                self.refresh()
        except AuthError:
            self.jot.token = None
            self.refresh()
            return
        except OSError as e:
            self.notice = f"Offline: {e}" if not self.jot.items else None
            self.refresh()
        threading.Thread(target=self.jot.events, args=(self.on_server_change,), daemon=True).start()

    def on_server_change(self):
        try:
            if self.jot.sync():
                self.refresh()
        except (OSError, AuthError):
            pass

    def run(self):
        self.emit({"activations": True, "live": True, "prompt": "jot",
                   "placeholder": "Jot something down, or search…"})
        if self.jot.token:
            threading.Thread(target=self.background_sync, daemon=True).start()
        for line in sys.stdin:
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            q = msg.get("query", "")
            if "activate" in msg:
                a = msg["activate"]
                fn = self.handlers.get(a.get("id"))
                if fn:
                    self.notice = None
                    try:
                        if fn(a.get("action")) == "nav":
                            continue  # the new query brings the view
                    except (OSError, AuthError) as e:
                        self.notice = f"Jot said no: {e}"
            self.query = q
            with self.refresh_lock:
                self.show(q)


