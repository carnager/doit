MONTHS = {"jan": 1, "january": 1, "januar": 1, "jänner": 1, "jaenner": 1, "feb": 2, "february": 2, "februar": 2,
          "mar": 3, "march": 3, "märz": 3, "maerz": 3, "mrz": 3, "apr": 4, "april": 4, "may": 5, "mai": 5,
          "jun": 6, "june": 6, "juni": 6, "jul": 7, "july": 7, "juli": 7, "aug": 8, "august": 8,
          "sep": 9, "sept": 9, "september": 9, "oct": 10, "october": 10, "okt": 10, "oktober": 10,
          "nov": 11, "november": 11, "dec": 12, "december": 12, "dez": 12, "dezember": 12}
PREFIX = {"on", "am", "at", "um", "by", "bis", "@", "due"}
EVERY = {"every", "each", "jeden", "jede", "jedes", "jeder", "alle"}
AND = {",", "and", "und", "&", "+"}
UNIT = {"day": "day", "days": "day", "d": "day", "tag": "day", "tage": "day", "tagen": "day",
        "week": "week", "weeks": "week", "w": "week", "woche": "week", "wochen": "week",
        "month": "month", "months": "month", "monat": "month", "monate": "month", "monaten": "month",
        "year": "year", "years": "year", "y": "year", "jahr": "year", "jahre": "year", "jahren": "year",
        "hour": "hour", "hours": "hour", "h": "hour", "hr": "hour", "hrs": "hour", "stunde": "hour",
        "stunden": "hour", "std": "hour",
        "min": "min", "mins": "min", "minute": "min", "minutes": "min", "minuten": "min"}
EVENING = 19 * 60
WORKDAYS = ["mo", "tu", "we", "th", "fr"]
NEXT_RE = re.compile(r"^(next|nächste|nächsten|nächster|nächstes|naechste|naechsten|naechster|kommenden|kommender|coming)$")
DAYNUM_RE = re.compile(r"^(\d{1,2})(?:\.|st|nd|rd|th)?$")


def is_num(s):
    return bool(s) and s.isascii() and s.isdigit()


def month_of(s):
    return MONTHS.get(s[:-1] if s.endswith(".") else s) if s else None


def valid_date(y, m, d):
    return 1 <= m <= 12 and 1 <= d <= days_in_month(y, m)


def next_yearless(m, d, today):
    y = from_day(today)[0]
    if not valid_date(y, m, d) and not (m == 2 and d == 29):
        return None
    for _ in range(8):
        if valid_date(y, m, d) and day_num(y, m, d) >= today:
            return day_num(y, m, d)
        y += 1
    return None


def full_year(s):
    return 2000 + int(s) if len(s) == 2 else int(s)


def tokenize(line):
    return [{"t": m.group(), "l": m.group().lower(), "s": m.start(), "e": m.end()}
            for m in re.finditer(r"[^\s,]+|,", line)]


def tl(T, i):
    return T[i]["l"] if 0 <= i < len(T) else None


def match_time(T, i, prefixed):
    a, b = tl(T, i), tl(T, i + 1)
    if not a:
        return None
    if a in ("noon", "mittag", "mittags"):
        return {"n": 1, "time": 12 * 60}
    if a in ("midnight", "mitternacht"):
        return {"n": 1, "time": 0}

    def h12(h, mm, ap):
        if h < 1 or h > 12 or mm > 59:
            return None
        return (h % 12 + (12 if ap.startswith("p") else 0)) * 60 + mm

    def h24(h, mm):
        return h * 60 + mm if h <= 23 and mm <= 59 else None

    def res(n, t):
        return None if t is None else {"n": n, "time": t}

    m = re.match(r"^(\d{1,2})(?::(\d{2}))?(am|pm|a\.m\.|p\.m\.)$", a)
    if m:
        return res(1, h12(int(m[1]), int(m[2] or 0), m[3]))
    m = re.match(r"^(\d{1,2}):(\d{2})(?:h|uhr)?$", a)
    if m:
        if b in ("am", "pm"):
            return res(2, h12(int(m[1]), int(m[2]), b))
        return res(2 if b == "uhr" else 1, h24(int(m[1]), int(m[2])))
    m = re.match(r"^(\d{1,2})(?:h|uhr)$", a)
    if m:
        return res(1, h24(int(m[1]), 0))
    if is_num(a) and len(a) <= 2:
        if b in ("am", "pm"):
            return res(2, h12(int(a), 0, b))
        if b == "uhr":
            return res(2, h24(int(a), 0))
        if prefixed:
            return res(1, h24(int(a), 0))
    return None


def with_evening(T, i, r):
    if tl(T, i + r["n"]) in ("abend", "evening", "night"):
        return dict(r, n=r["n"] + 1, time=EVENING)
    return r


def next_weekday(today, wd, include_today=False):
    diff = (wd - weekday(today) + 7) % 7
    if diff == 0 and not include_today:
        diff = 7
    return today + diff


def match_date(T, i, ctx, prefixed):
    a, b, c = tl(T, i), tl(T, i + 1), tl(T, i + 2)
    if not a:
        return None
    today = ctx["day"]
    if a in ("today", "heute"):
        return with_evening(T, i, {"n": 1, "date": today})
    if a == "tonight":
        return {"n": 1, "date": today, "time": EVENING}
    if a in ("tomorrow", "tmrw", "tmr", "morgen"):
        return with_evening(T, i, {"n": 1, "date": today + 1})
    if a in ("übermorgen", "uebermorgen"):
        return with_evening(T, i, {"n": 1, "date": today + 2})
    if a in ("weekend", "wochenende"):
        return {"n": 1, "date": next_weekday(today, 5, True)}
    if a in ("this", "dieses", "am") and b in ("weekend", "wochenende"):
        return {"n": 2, "date": next_weekday(today, 5, True)}
    if NEXT_RE.match(a) and b:
        if b in ("week", "woche"):
            return {"n": 2, "date": next_weekday(today, 0)}
        if b in ("month", "monat"):
            y, mo, _ = from_day(today)
            return {"n": 2, "date": day_num(y + 1, 1, 1) if mo == 12 else day_num(y, mo + 1, 1)}
        if b in ("year", "jahr"):
            return {"n": 2, "date": day_num(from_day(today)[0] + 1, 1, 1)}
        wd = WDAY.get(b, WDAY2.get(b))
        if wd is not None:
            return {"n": 2, "date": next_weekday(today, wd)}
    if a in WDAY:
        return {"n": 1, "date": next_weekday(today, WDAY[a])}
    if a in WDAY2 and (prefixed or match_time(T, i + 1, False)):
        return {"n": 1, "date": next_weekday(today, WDAY2[a])}
    if a == "in" and b:
        n = unit = None
        used = 0
        m = re.match(r"^(\d+)(d|w|h|m|min)$", b)
        if is_num(b) and c in UNIT:
            n, unit, used = int(b), UNIT[c], 3
        elif m:
            n, unit, used = int(m[1]), {"d": "day", "w": "week", "h": "hour", "m": "min", "min": "min"}[m[2]], 2
        elif b in ("a", "an", "einer", "einem", "one") and c in UNIT:
            n, unit, used = 1, UNIT[c], 3
        if n is not None and unit:
            if unit == "day":
                return {"n": used, "date": today + n}
            if unit == "week":
                return {"n": used, "date": today + 7 * n}
            if unit == "month":
                y, mo, d = from_day(today)
                idx = y * 12 + mo - 1 + n
                ny, nm = idx // 12, idx % 12 + 1
                return {"n": used, "date": day_num(ny, nm, min(d, days_in_month(ny, nm)))}
            if unit == "year":
                y, mo, d = from_day(today)
                return {"n": used, "date": day_num(y + n, mo, min(d, days_in_month(y + n, mo)))}
            total = -(-(today * 1440 + ctx["min"] + (60 if unit == "hour" else 1) * n) // 5) * 5
            return {"n": used, "date": total // 1440, "time": total % 1440}
    m = re.match(r"^(\d{4})-(\d{1,2})-(\d{1,2})$", a)
    if m:
        y, mo, d = int(m[1]), int(m[2]), int(m[3])
        return {"n": 1, "date": day_num(y, mo, d)} if valid_date(y, mo, d) else None
    m = re.match(r"^(\d{1,2})\.(\d{1,2})(?:\.(\d{4}|\d{2})?)?$", a)
    if m:
        d, mo = int(m[1]), int(m[2])
        if m[3]:
            y = full_year(m[3])
            return {"n": 1, "date": day_num(y, mo, d)} if valid_date(y, mo, d) else None
        dt = next_yearless(mo, d, today)
        return None if dt is None else {"n": 1, "date": dt}
    m = re.match(r"^(\d{1,2})/(\d{1,2})(?:/(\d{4}|\d{2}))?$", a)
    if m:
        mo, d = int(m[1]), int(m[2])
        if m[3]:
            y = full_year(m[3])
            return {"n": 1, "date": day_num(y, mo, d)} if valid_date(y, mo, d) else None
        dt = next_yearless(mo, d, today)
        return None if dt is None else {"n": 1, "date": dt}
    m = DAYNUM_RE.match(a)
    if m and month_of(b):
        d, mo = int(m[1]), month_of(b)
        if is_num(c) and len(c) == 4:
            return {"n": 3, "date": day_num(int(c), mo, d)} if valid_date(int(c), mo, d) else None
        dt = next_yearless(mo, d, today)
        return None if dt is None else {"n": 2, "date": dt}
    m = DAYNUM_RE.match(b) if b else None
    if month_of(a) and m:
        d, mo = int(m[1]), month_of(a)
        k = 2
        if c == "," and is_num(tl(T, i + 3)) and len(tl(T, i + 3)) == 4:
            k = 3
        y_tok = tl(T, i + k)
        if is_num(y_tok) and len(y_tok) == 4:
            return {"n": k + 1, "date": day_num(int(y_tok), mo, d)} if valid_date(int(y_tok), mo, d) else None
        dt = next_yearless(mo, d, today)
        return None if dt is None else {"n": 2, "date": dt}
    return None


def weekday_list(T, i):
    def wd_of(s):
        return WDAY.get(s, WDAY2.get(s, WDAY_PLURAL.get(s))) if s else None
    days, j = [], i
    while j < len(T):
        w = wd_of(T[j]["l"])
        if w is None:
            break
        days.append(w)
        j += 1
        if j < len(T) and T[j]["l"] in AND and wd_of(tl(T, j + 1)) is not None:
            j += 1
            continue
        break
    return {"n": j - i, "byDay": [WD[d] for d in sorted(set(days))]} if days else None


def match_after_done(T, i):
    a, b = tl(T, i), tl(T, i + 1)
    if a == "after" and b in ("done", "completion", "completed", "finishing"):
        return 2
    if a == "nach" and b in ("erledigung", "abschluss", "erledigt"):
        return 2
    return 0


def match_repeat(T, i):
    a = tl(T, i)
    if not a:
        return None
    r, n = None, 0
    if a in ("daily", "täglich", "taeglich"):
        r, n = {"freq": "day", "interval": 1}, 1
    elif a in ("weekdays", "werktags", "wochentags"):
        r, n = {"freq": "week", "interval": 1, "byDay": WORKDAYS}, 1
    elif a in ("weekly", "wöchentlich", "woechentlich"):
        r, n = {"freq": "week", "interval": 1}, 1
    elif a in ("biweekly", "fortnightly"):
        r, n = {"freq": "week", "interval": 2}, 1
    elif a in ("monthly", "monatlich"):
        r, n = {"freq": "month", "interval": 1}, 1
    elif a in ("yearly", "annually", "jährlich", "jaehrlich"):
        r, n = {"freq": "year", "interval": 1}, 1
    elif a in WDAY_PLURAL:
        wl = weekday_list(T, i)
        r, n = {"freq": "week", "interval": 1, "byDay": wl["byDay"]}, wl["n"]
    elif a in EVERY:
        j, interval = i + 1, 1
        if tl(T, j) in ("other", "zweiten"):
            interval, j = 2, j + 1
        b, c = tl(T, j), tl(T, j + 1)
        if not b:
            return None
        m = re.match(r"^(\d{1,2})(st|nd|rd|th|\.)$", b)
        if b in ("day", "tag"):
            r, n = {"freq": "day", "interval": interval}, j + 1 - i
        elif b in ("weekday", "werktag", "wochentag"):
            r, n = {"freq": "week", "interval": 1, "byDay": WORKDAYS}, j + 1 - i
        elif b in ("week", "woche"):
            r, n = {"freq": "week", "interval": interval}, j + 1 - i
        elif b in ("month", "monat"):
            r, n = {"freq": "month", "interval": interval}, j + 1 - i
        elif b in ("year", "jahr"):
            r, n = {"freq": "year", "interval": interval}, j + 1 - i
        elif is_num(b) and UNIT.get(c) in ("day", "week", "month", "year"):
            r, n = {"freq": UNIT[c], "interval": max(1, int(b))}, j + 2 - i
        elif m and 1 <= int(m[1]) <= 31:
            r, n = {"freq": "month", "interval": 1, "monthDay": int(m[1])}, j + 1 - i
        else:
            wl = weekday_list(T, j)
            if wl:
                r, n = {"freq": "week", "interval": interval, "byDay": wl["byDay"]}, j + wl["n"] - i
    if not r:
        return None
    k = match_after_done(T, i + n)
    if k:
        r["fromCompletion"], n = True, n + k
    return {"n": n, "repeat": r}


def quickadd(text, now_day, now_min):
    """Text → {title, kind, checks, labels, due, repeat, pinned, tokens}."""
    ctx = {"day": now_day, "min": now_min}
    lines = text.split("\n")
    line = lines[0]
    T = tokenize(line)
    st = {"date": None, "time": None, "repeat": None, "pinned": False}
    labels, tokens = [], []
    i = 0
    while i < len(T):
        tok = T[i]
        hit = None
        lm = re.match(r"^#([\w-]+)$", tok["t"])
        if lm:
            hit = (1, "label", lambda lm=lm: labels.append(lm[1].lower()))
        if not hit and tok["t"] == "!" and i == len(T) - 1 and i > 0:
            hit = (1, "pin", lambda: st.update(pinned=True))
        if not hit and not st["repeat"]:
            r = match_repeat(T, i)
            if r:
                hit = (r["n"], "repeat", lambda r=r: st.update(repeat=r["repeat"]))
        if not hit and st["repeat"] and not st["repeat"].get("fromCompletion"):
            k = match_after_done(T, i)
            if k:
                hit = (k, "repeat", lambda: st["repeat"].update(fromCompletion=True))

        def set_date(d):
            st["date"] = d["date"]
            if d.get("time") is not None and st["time"] is None:
                st["time"] = d["time"]
        if not hit and tok["l"] in PREFIX and i + 1 < len(T):
            d = match_date(T, i + 1, ctx, True) if st["date"] is None else None
            if d:
                hit = (d["n"] + 1, "date", lambda d=d: set_date(d))
            elif st["time"] is None:
                t = match_time(T, i + 1, True)
                if t:
                    hit = (t["n"] + 1, "time", lambda t=t: st.update(time=t["time"]))
        if not hit and st["date"] is None:
            d = match_date(T, i, ctx, False)
            if d:
                hit = (d["n"], "date", lambda d=d: set_date(d))
        if not hit and st["time"] is None:
            t = match_time(T, i, False)
            if t:
                hit = (t["n"], "time", lambda t=t: st.update(time=t["time"]))
        if hit:
            n, kind, apply = hit
            apply()
            tokens.append({"s": T[i]["s"], "e": T[i + n - 1]["e"], "type": kind})
            i += n
            continue
        i += 1

    title, last = "", 0
    for t in tokens:
        title += line[last:t["s"]]
        last = t["e"]
    title += line[last:]
    title = re.sub(r"\s+", " ", title)
    title = re.sub(r"\s+,", ",", title)
    title = re.sub(r"^[\s,]+|[\s,]+$", "", title)

    kind, checks = "note", []
    rest = [ln for ln in lines[1:] if ln.strip()]
    if rest:
        kind = "list"
        for ln in rest:
            m = re.match(r"^\s*(?:[-*•]\s+|\[( |x|X)?\]\s*)?(.*)$", ln)
            if m[2].strip():
                checks.append({"text": m[2].strip(), "done": m[1] in ("x", "X")})
    else:
        cm = re.match(r"^([^:]+):\s*(.+)$", title)
        if cm and "," in cm[2]:
            parts = [p.strip() for p in cm[2].split(",") if p.strip()]
            if len(parts) >= 2:
                kind, title = "list", cm[1].strip()
                checks = [{"text": p, "done": False} for p in parts]

    due = ""
    if st["date"] is not None:
        due = fmt_due(st["date"], st["time"])
    elif st["repeat"]:
        due = fmt_due(first_occurrence(now_day, st["time"], st["repeat"], now_day, now_min), st["time"])
    elif st["time"] is not None:
        due = fmt_due(now_day if st["time"] > now_min else now_day + 1, st["time"])
    return {"title": title, "kind": kind, "checks": checks, "labels": sorted(set(labels)), "due": due,
            "repeat": st["repeat"], "pinned": st["pinned"], "tokens": tokens}


def parse_when(text, now_day, now_min):
    r = quickadd("x " + text, now_day, now_min)
    return r["due"], r["repeat"], any(t["type"] != "label" for t in r["tokens"])


