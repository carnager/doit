CROCK = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
GROUPS = {"title": ["title"], "body": ["body"], "kind": ["kind"], "color": ["color"], "labels": ["labels"],
          "pinned": ["pinned"], "archived": ["archived"],
          "schedule": ["done", "doneAt", "due", "remind", "alerts", "snoozedUntil", "repeat"],
          "sort": ["sort"], "images": ["images"], "trash": ["trashedAt"]}
COLORS = {"red": "#e5484d", "orange": "#f76b15", "yellow": "#ffc53d", "green": "#30a46c", "teal": "#12a594",
          "blue": "#0090ff", "purple": "#8e4ec6", "pink": "#d6409f", "brown": "#ad7f58", "gray": "#8b8d98"}


def ulid(t=None):
    t = int(time.time() * 1000) if t is None else t
    ts = ""
    for _ in range(10):
        ts, t = CROCK[t % 32] + ts, t // 32
    return ts + "".join(CROCK[b % 32] for b in secrets.token_bytes(16))


def short_id():
    return ulid()[-10:].lower()


def now_ms():
    return int(time.time() * 1000)


def new_item(fields):
    now = now_ms()
    it = {"id": ulid(now), "kind": "note", "title": "", "body": "", "checks": [], "color": "", "labels": [],
          "pinned": False, "archived": False, "done": False, "doneAt": 0, "due": "", "remind": True,
          "snoozedUntil": "", "repeat": None, "sort": now, "createdAt": now, "updatedAt": now,
          "trashedAt": 0, "deleted": False}
    it.update(fields)
    it["checks"] = [dict({"id": short_id(), "indent": 0, "done": False, "u": now}, **c) for c in fields.get("checks", [])]
    return it


def stamped(prev, nxt, now):
    """`nxt` with fm and check stamps for what changed since `prev`."""
    out = dict(nxt)
    fm = dict(prev.get("fm") or {})
    for g, fields in GROUPS.items():
        if any(json.dumps(prev.get(f)) != json.dumps(nxt.get(f)) for f in fields):
            fm[g] = now
    before = {c["id"]: c for c in prev.get("checks") or []}
    checks, order_changed = [], False
    for c in nxt.get("checks") or []:
        p = before.get(c["id"])
        if c.get("deleted"):
            checks.append(p if p and p.get("deleted") else {"id": c["id"], "deleted": True, "u": now})
            order_changed |= bool(p and not p.get("deleted"))
            continue
        changed = not p or p.get("deleted") or p.get("text") != c.get("text") or bool(p.get("done")) != bool(c.get("done")) \
            or (p.get("indent") or 0) != (c.get("indent") or 0)
        order_changed |= not p or bool(p.get("deleted"))
        checks.append(dict(c, u=now) if changed else c)
    if prev.get("checks") or nxt.get("checks"):
        out["checks"] = checks
    if order_changed:
        fm["order"] = now
    out["fm"], out["updatedAt"] = fm, now
    return out


def norm(s):
    return "".join(ch for ch in unicodedata.normalize("NFD", s or "") if not unicodedata.combining(ch)).lower()


def live_checks(it):
    return [c for c in it.get("checks") or [] if not c.get("deleted")]


def haystack(it):
    return norm("\n".join([it.get("title") or "", it.get("body") or ""] + [c.get("text") or "" for c in live_checks(it)]
                          + ["#" + lb + " " + lb for lb in it.get("labels") or []]))


def alive(it):
    return not it.get("deleted") and not it.get("trashedAt")


def due_key(it):
    p = parse_due(it.get("due"))
    return (p[0] * 1440 + (p[1] if p[1] is not None else -1)) if p else float("inf")


