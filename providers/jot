def copy(text):
    try:
        subprocess.run(["wl-copy"], input=text.encode(), timeout=3, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def notify(title, body):
    try:
        subprocess.Popen(["notify-send", "-a", "Jot", "-i", "checkbox-checked-symbolic", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def ask(prompt, placeholder, password=False, query=""):
    """One line from the user, through doit itself."""
    cmd = ["doit", "-d", "-l", "0", "-p", prompt, "--no-exec", "--placeholder", placeholder]
    if password:
        cmd.append("--password")
    if query:
        cmd += ["-q", query]
    r = subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True)
    return r.stdout.rstrip("\n") if r.returncode == 0 else None


def login(cfg):
    jot = Jot(cfg["server"])
    user = cfg.get("username") or ask("Jot", f"Username on {cfg['server'].split('://')[-1]}")
    if not user:
        return 1
    for attempt in range(3):
        pw = ask("Jot", f"Password for {user}" if not attempt else "Wrong password, try again", password=True)
        if not pw:
            return 1
        try:
            jot.login(user, pw)
        except AuthError:
            continue
        except OSError as e:
            notify("Jot", f"Couldn't sign in: {e}")
            return 1
        os.execvp("doit", ["doit", "-P", json.dumps(os.path.abspath(__file__)), "-p", "jot", "--no-custom"])
    notify("Jot", "Wrong username or password")
    return 1


def main():
    args = sys.argv[1:]
    cfg = load_config()
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if not cfg.get("server"):
        print(json.dumps({"title": "Jot isn't set up", "subtitle": f"Put server = \"https://…\" in {CONFIG}",
                          "icon": "dialog-error"}))
        return 0
    if args[:1] == ["--login"]:
        return login(cfg)
    if args[:1] == ["--logout"]:
        Jot(cfg["server"]).logout()
        return 0
    if args[:1] == ["--launch"]:
        os.execvp("doit", ["doit", "-P", json.dumps(os.path.abspath(__file__)), "-p", "jot", "--no-custom"] + args[1:])
    try:
        Mode(cfg).run()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
