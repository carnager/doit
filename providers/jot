WDAY2 = {"mo": 0, "di": 1, "mi": 2, "do": 3, "fr": 4, "sa": 5, "so": 6}
WDAY_PLURAL = {"mondays": 0, "montags": 0, "tuesdays": 1, "dienstags": 1, "wednesdays": 2, "mittwochs": 2,
               "thursdays": 3, "donnerstags": 3, "fridays": 4, "freitags": 4, "saturdays": 5, "samstags": 5,
